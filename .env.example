# Chanrai Nigeria website: server settings. Copy to .env and fill in. Keep .env private.
# Company details, the mail server, pages and products are set in the dashboard, not here.

# ---- Required ----
# Public address of the site, used in emails and links (no trailing slash)
SITE_URL=https://www.chanrainigeria.com

# Domain(s) the HTTPS proxy serves, comma separated. Their DNS must already point at this server.
SITE_DOMAINS=chanrainigeria.com, www.chanrainigeria.com
# "https" runs the built-in HTTPS proxy (Caddy) on ports 80 and 443.
# Leave empty if the server already has its own proxy; then point it at 127.0.0.1:3000.
COMPOSE_PROFILES=https

# Database password: a long random string of letters and digits only. Set once, never change.
# Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs dashboard sessions and encrypts the saved mail password. Generate with:  openssl rand -base64 48
# Keep a copy somewhere safe: if it changes, everyone is signed out and the mail password must be retyped.
AUTH_SECRET=

# Private code (12+ characters) typed once at /admin/setup to create the first account.
SETUP_TOKEN=

# Protects the daily overdue-enquiry reminder. Generate with:  openssl rand -hex 16
CRON_SECRET=

# ---- Email ----
# Easiest: leave these empty and set the mail server in the dashboard (Email and alerts), which has a
# Test button. These are only a fallback, used when nothing is set in the dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Set to 1 only if the mail server is on the company's internal network (e.g. on-premises Exchange).
ALLOW_PRIVATE_SMTP=

# ---- Enyo AI (website chat and dashboard assistant), optional ----
# Any OpenAI-compatible endpoint. Without a key both assistants run in basic mode.
ENYO_LLM_BASE_URL=https://api.groq.com/openai/v1
ENYO_LLM_API_KEY=
# A model that supports tool calling, e.g. openai/gpt-oss-120b or llama-3.3-70b-versatile on Groq
ENYO_LLM_MODEL=
# Optional smaller model for greetings and short questions, e.g. llama-3.1-8b-instant
ENYO_LLM_FAST_MODEL=

# ---- Optional ----
# Header holding the visitor's real address. The Docker setup defaults to x-real-ip.
# Behind Cloudflare use cf-connecting-ip. Vercel needs nothing.
TRUSTED_IP_HEADER=
# 1 keeps the site out of search engines (for a preview). Leave empty when live.
PREVIEW_NOINDEX=
MAX_UPLOAD_MB=8
DATABASE_POOL_MAX=5
WEB_PORT=3000
# Only without Docker (Vercel, a managed database or local development): the database addresses.
# With Docker these are set for you from POSTGRES_PASSWORD.
#DATABASE_URL=postgresql://chanrai:password@localhost:5432/chanrai
#DIRECT_URL=postgresql://chanrai:password@localhost:5432/chanrai
# Create the first admin from the seed instead of /admin/setup
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ---- Platform credit (dashboard sign-in, footer and loader only; never on the website or emails) ----
PLATFORM_NAME=
PLATFORM_POWERED_BY=
PLATFORM_MAKER=
PLATFORM_URL=
PLATFORM_SUPPORT_EMAIL=
PLATFORM_SUPPORT_PHONE=
