# ---- Required ----
# Public address of the site, used in emails and links (no trailing slash)
SITE_URL=https://www.chanrainigeria.com
# Random string of 32+ characters. Generate with:  openssl rand -base64 48
AUTH_SECRET=

# Private code (12+ characters) you type once at /admin/setup to create the platform account.
SETUP_TOKEN=

# Protects the daily overdue-enquiry reminder (/api/cron/overdue). Random, 16+ characters.
CRON_SECRET=

# The one request header that holds the visitor's real address, set by your reverse proxy.
# Vercel needs nothing here. Behind Cloudflare use cf-connecting-ip; behind nginx use x-real-ip.
# Leave empty only for local testing: every visitor then shares one rate-limit bucket.
TRUSTED_IP_HEADER=

# Database. With docker-compose these are set for you from POSTGRES_PASSWORD.
# On Supabase/Neon/managed Postgres, paste the connection strings here.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://chanrai:password@localhost:5432/chanrai
DIRECT_URL=postgresql://chanrai:password@localhost:5432/chanrai

# ---- Email (enquiry notifications and customer acknowledgements) ----
# Use the company's mail host, Microsoft 365 / Google Workspace SMTP, or a service like Brevo or Zoho.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Fallback sender if none is set in Admin → Settings → Email
SMTP_FROM=

# ---- Enyo assistant (optional; without a key Enyo runs in basic mode) ----
# Any OpenAI-compatible API. Groq: https://console.groq.com/keys
ENYO_API_KEY=
ENYO_API_URL=https://api.groq.com/openai/v1

# ---- Optional ----
# 1 keeps a preview out of search engines. Remove when the site is live.
PREVIEW_NOINDEX=
# Create the first admin from the seed instead of /admin/setup
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
MAX_UPLOAD_MB=8
DATABASE_POOL_MAX=5
WEB_PORT=3000
