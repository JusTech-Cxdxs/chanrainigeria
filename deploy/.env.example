# Chanrai Nigeria website settings for the server. Keep this file private.
# Everything else (company details, email server, alerts, pages, products) is set in the dashboard.

# The public address of the site, no trailing slash
SITE_URL=https://www.chanrainigeria.com

# Database password: any long random string. Set it once and never change it afterwards.
POSTGRES_PASSWORD=

# Signs dashboard sessions and encrypts the mail password. 48+ random characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=

# Private code typed once at /admin/setup to create the platform support account (12+ characters).
SETUP_TOKEN=

# Protects the daily overdue-enquiry reminder. 16+ random characters.
CRON_SECRET=

# The header your reverse proxy sets with the visitor's real address (see INSTALL.md).
TRUSTED_IP_HEADER=x-real-ip

# Optional: the website assistant's AI key (Groq). Without it the assistant runs in basic mode.
ENYO_API_KEY=
ENYO_API_URL=https://api.groq.com/openai/v1

# Optional: the image name if you renamed it when loading
WEB_IMAGE=chanrai-web:latest
WEB_PORT=3000
